  <text x="256" y="474" text-anchor="middle"
    font-family="Georgia, serif"
    font-size="17" fill="#4ab5a0"
    letter-spacing="5" font-style="italic"
    opacity="0.65">The Star Record</text>
  <line x1="140" y1="488" x2="372" y2="488" stroke="#e8b84b" stroke-width="0.8" stroke-opacity="0.2"/>
  <circle cx="256" cy="488" r="2" fill="#e8b84b" opacity="0.3"/>

</g>
</svg>