<svg width="512" height="512" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
<defs>
  <radialGradient id="sky" cx="50%" cy="35%" r="70%">
    <stop offset="0%" stop-color="#12183a"/>
    <stop offset="60%" stop-color="#080e22"/>
    <stop offset="100%" stop-color="#04060f"/>
  </radialGradient>
  <radialGradient id="hGlow" cx="50%" cy="50%" r="50%">
    <stop offset="0%" stop-color="#f4a050" stop-opacity="0.7"/>
    <stop offset="100%" stop-color="#f4a050" stop-opacity="0"/>
  </radialGradient>
  <radialGradient id="horizWarm" cx="50%" cy="100%" r="55%">
    <stop offset="0%" stop-color="#1c2e48" stop-opacity="0.5"/>
    <stop offset="100%" stop-color="#04060f" stop-opacity="0"/>
  </radialGradient>
  <linearGradient id="textFade" x1="0%" y1="0%" x2="0%" y2="100%">
    <stop offset="0%" stop-color="#04060f" stop-opacity="0"/>
    <stop offset="45%" stop-color="#04060f" stop-opacity="0.88"/>
    <stop offset="100%" stop-color="#04060f" stop-opacity="1"/>
  </linearGradient>
  <filter id="goldGlow">
    <feGaussianBlur stdDeviation="4" result="blur"/>
    <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
  </filter>
  <filter id="starGlow">
    <feGaussianBlur stdDeviation="6" result="blur"/>
    <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
  </filter>
  <filter id="softGlow">
    <feGaussianBlur stdDeviation="18"/>
  </filter>
  <clipPath id="clip"><rect width="512" height="512" rx="86"/></clipPath>
</defs>

<g clip-path="url(#clip)">

  <!-- Sky -->
  <rect width="512" height="512" fill="url(#sky)"/>
  <rect width="512" height="512" fill="url(#horizWarm)"/>

  <!-- Star compass watermark -->
  <g opacity="0.12">
    <circle cx="256" cy="340" r="195" fill="none" stroke="#e8b84b" stroke-width="1.2"/>
    <circle cx="256" cy="340" r="130" fill="none" stroke="#e8b84b" stroke-width="0.8"/>
    <circle cx="256" cy="340" r="65" fill="none" stroke="#e8b84b" stroke-width="0.6"/>
    <line x1="256" y1="145" x2="256" y2="535" stroke="#e8b84b" stroke-width="1"/>
    <line x1="61" y1="340" x2="451" y2="340" stroke="#e8b84b" stroke-width="1"/>
    <line x1="256" y1="145" x2="256" y2="535" stroke="#e8b84b" stroke-width="0.7" transform="rotate(45 256 340)"/>
    <line x1="256" y1="145" x2="256" y2="535" stroke="#e8b84b" stroke-width="0.7" transform="rotate(135 256 340)"/>
    <line x1="256" y1="145" x2="256" y2="162" stroke="#e8b84b" stroke-width="0.8" transform="rotate(22.5 256 340)"/>
    <line x1="256" y1="145" x2="256" y2="162" stroke="#e8b84b" stroke-width="0.8" transform="rotate(67.5 256 340)"/>
    <line x1="256" y1="145" x2="256" y2="162" stroke="#e8b84b" stroke-width="0.8" transform="rotate(112.5 256 340)"/>
    <line x1="256" y1="145" x2="256" y2="162" stroke="#e8b84b" stroke-width="0.8" transform="rotate(157.5 256 340)"/>
    <line x1="256" y1="145" x2="256" y2="162" stroke="#e8b84b" stroke-width="0.8" transform="rotate(202.5 256 340)"/>
    <line x1="256" y1="145" x2="256" y2="162" stroke="#e8b84b" stroke-width="0.8" transform="rotate(247.5 256 340)"/>
    <line x1="256" y1="145" x2="256" y2="162" stroke="#e8b84b" stroke-width="0.8" transform="rotate(292.5 256 340)"/>
    <line x1="256" y1="145" x2="256" y2="162" stroke="#e8b84b" stroke-width="0.8" transform="rotate(337.5 256 340)"/>
    <circle cx="256" cy="340" r="3" fill="#e8b84b"/>
  </g>

  <!-- Hōkūleʻa star -->
  <circle cx="340" cy="118" r="70" fill="url(#hGlow)" filter="url(#softGlow)" opacity="0.8"/>
  <circle cx="340" cy="118" r="28" fill="#f4a050" filter="url(#softGlow)" opacity="0.25"/>
  <circle cx="340" cy="118" r="12" fill="#f4a050" filter="url(#starGlow)" opacity="0.98"/>
  <circle cx="340" cy="118" r="5" fill="#fff4e0" opacity="0.98"/>

  <!-- Maunakea silhouette -->
  <polygon points="
    0,330 55,300 100,278 138,262 170,250 200,240 228,232 256,226
    284,230 312,237 342,246 372,258 404,272 440,290 478,310 512,328
    512,512 0,512"
    fill="#050a08"/>
  <polyline points="
    0,330 55,300 100,278 138,262 170,250 200,240 228,232 256,226
    284,230 312,237 342,246 372,258 404,272 440,290 478,310 512,328"
    fill="none" stroke="#0e1a10" stroke-width="1.5"/>

  <!-- Text fade -->
  <rect x="0" y="250" width="512" height="262" fill="url(#textFade)"/>

  <!-- App name -->
  <text x="256" y="370" text-anchor="middle"
    font-family="Cinzel, Georgia, serif"
    font-size="92" font-weight="700"
    fill="#e8b84b" letter-spacing="8"
